# 生成 web_assets.c：把 web/ 下的静态文件编译进可执行文件
# 用法：cmake -DWEB_DIR=... -DOUT=... -P embed.cmake

file(GLOB_RECURSE WEB_FILES RELATIVE "${WEB_DIR}" "${WEB_DIR}/*")

set(content "/* generated by cmake/embed.cmake, do not edit */\n")
string(APPEND content "#include \"httpd/web_assets.h\"\n\n")

set(index 0)
set(entries "")
foreach(f ${WEB_FILES})
    if(IS_DIRECTORY "${WEB_DIR}/${f}")
        continue()
    endif()
    file(READ "${WEB_DIR}/${f}" HEX_DATA HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX_DATA}")
    string(LENGTH "${BYTES}" BLEN)
    string(APPEND content "static const unsigned char web_${index}[] = {${BYTES}0x00};\n")
    string(LENGTH "${HEX_DATA}" HEXLEN)
    math(EXPR DATA_LEN "${HEXLEN} / 2")
    string(APPEND entries "    {\"/${f}\", web_${index}, ${DATA_LEN}},\n")
    math(EXPR index "${index} + 1")
endforeach()

string(APPEND content "\nconst nd_web_asset nd_web_assets[] = {\n")
if(index EQUAL 0)
    string(APPEND content "    {\"/index.html\", (const unsigned char *)\"\", 0},\n")
else()
    string(APPEND content "${entries}")
endif()
string(APPEND content "};\n")
string(APPEND content "const size_t nd_web_assets_count = sizeof(nd_web_assets) / sizeof(nd_web_assets[0]);\n")

file(WRITE "${OUT}" "${content}")
